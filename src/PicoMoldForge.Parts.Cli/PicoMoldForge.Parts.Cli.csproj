<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PicoMoldForge.Parts.Core\PicoMoldForge.Parts.Core.csproj" />
    <ProjectReference Include="..\PicoMoldForge.Parts.PicoGK\PicoMoldForge.Parts.PicoGK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\parts\*.json" LogicalName="PicoMoldForge.Parts.Samples.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Viewer\index.html" LogicalName="PicoMoldForge.Parts.Viewer.index.html" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PicoMoldForge.Parts.Cli</RootNamespace>
    <AssemblyName>PicoMoldForge.Parts.Cli</AssemblyName>
    <Version>1.0.0</Version>
    <Description>PicoMoldForge Parts command line: generate mechanical parts (CAD) from recipes, verify them and view them in the "modo malla" viewer.</Description>
  </PropertyGroup>

</Project>
